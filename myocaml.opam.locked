  "stdune" {= "3.20.2" & with-test}
  "stringext" {= "1.6.0"}
  "textutils" {= "v0.17.0"}
  "textwrap" {= "0.2.1"}
  "time_now" {= "v0.17.0"}
  "timezone" {= "v0.17.0"}
  "topkg" {= "1.1.1"}
  "typerep" {= "v0.17.1"}
  "uopt" {= "v0.17.0"}
